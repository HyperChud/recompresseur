<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.recompresseur" android:versionCode="3" android:versionName="2.0">
  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="23"/>
  <application android:label="Recompresseur" android:icon="@drawable/ic" android:allowBackup="false"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <meta-data android:name="android.max_aspect" android:value="3.0"/>
    <activity android:name=".MainActivity" android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
        android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter android:label="Recompresser">
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
